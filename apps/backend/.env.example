# Backend-local overrides for running outside docker-compose (e.g. `poetry run uvicorn ...`).
# In the docker-compose stack, the root-level .env is used instead via env_file.
ENVIRONMENT=development
LOG_LEVEL=debug
DATABASE_URL=postgresql+asyncpg://copilot:changeme@localhost:5432/ai_startup_copilot
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
JWT_SECRET_KEY=dev-only-secret-change-me
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
