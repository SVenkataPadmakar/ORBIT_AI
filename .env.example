# =========================================================
# AI Startup Copilot — root environment file
# Copy to .env and fill in real values. Consumed by
# docker-compose.yml for every service.
# =========================================================

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=info

# ---- Postgres ----
POSTGRES_USER=copilot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_startup_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://copilot:changeme@postgres:5432/ai_startup_copilot

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- ChromaDB ----
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ---- Auth ----
JWT_SECRET_KEY=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ---- LLM Providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=

# ---- AWS / S3 ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=ai-startup-copilot-documents

# ---- Observability ----
SENTRY_DSN=

# ---- Frontend (public, exposed to the browser) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/v1
